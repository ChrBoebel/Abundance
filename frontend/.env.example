# Internal backend URL
RESEARCH_BACKEND_URL=http://localhost:8000

# Match backend ABUNDANCE_INTERNAL_API_TOKEN outside local development
RESEARCH_BACKEND_TOKEN=

# At least 32 characters; generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-secret

# At least 12 characters
APP_PASSWORD=replace-with-a-strong-local-password

# Required in production for distributed limits; optional during npm run dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Development port
PORT=4290
