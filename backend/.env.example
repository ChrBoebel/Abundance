# Required providers
OPENROUTER_API_KEY=your-openrouter-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Recommended outside local development; use the same value as the frontend's
# RESEARCH_BACKEND_TOKEN. Generate with: openssl rand -hex 32
ABUNDANCE_INTERNAL_API_TOKEN=

# Optional locally, required for durable staging/production runs. Apply migrations
# with: python -m abundance_research.migrations
ABUNDANCE_DATABASE_URL=postgresql://abundance:change-me@localhost:5432/abundance
ABUNDANCE_DATABASE_POOL_MIN_SIZE=1
ABUNDANCE_DATABASE_POOL_MAX_SIZE=10
ABUNDANCE_SHARE_BASE_URL=http://localhost:4290/shared
ABUNDANCE_LOG_LEVEL=INFO
# Use staging/production outside local development; these values require the
# internal API token above and make the service fail closed at startup.
ABUNDANCE_DEPLOYMENT_ENVIRONMENT=development

# Explicit browser origins (comma-separated)
ABUNDANCE_CORS_ORIGINS=http://localhost:4290

# Provider and output limits
ABUNDANCE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ABUNDANCE_PLANNING_MODEL_MAX_TOKENS=3000
ABUNDANCE_ASSESSMENT_MODEL_MAX_TOKENS=5000
ABUNDANCE_SYNTHESIS_MODEL_MAX_TOKENS=12000
ABUNDANCE_VERIFICATION_MODEL_MAX_TOKENS=1200
ABUNDANCE_EVIDENCE_ASSESSMENT_MODE=shadow
ABUNDANCE_CLAIM_VERIFICATION_MODE=shadow
ABUNDANCE_VERIFICATION_MODEL_ALIAS=deepseek-v4-flash
ABUNDANCE_ASSESSMENT_BATCH_SIZE=8
ABUNDANCE_ASSESSMENT_MAX_EVIDENCE=24
ABUNDANCE_ASSESSMENT_EXCERPT_CHARS=2500
ABUNDANCE_VERIFICATION_BATCH_SIZE=8
ABUNDANCE_VERIFICATION_MAX_PAIRS=40
ABUNDANCE_VERIFICATION_EXCERPT_CHARS=2500
ABUNDANCE_VERIFICATION_TIMEOUT_SECONDS=45
ABUNDANCE_VERIFICATION_SCHEMA_RETRIES=1
ABUNDANCE_PROVIDER_TIMEOUT_SECONDS=90
ABUNDANCE_PROVIDER_MAX_RETRIES=2
ABUNDANCE_SEARCH_TIMEOUT_SECONDS=45
ABUNDANCE_MAX_EVIDENCE_EXCERPT_CHARS=12000

# Server
PORT=8000
